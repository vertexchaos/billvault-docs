    "/api/receipts": {
      "get": {
        "description": "Phase 12.1: previously unbounded -- returned every matching row in\none response. limit/offset keep this from fetching/serializing the\nentire receipts table on every call.",
        "operationId": "list_receipts_api_receipts_get",
        "parameters": [
          {
            "in": "query",
            "name": "vendor",
            "required": false,
            "schema": {
