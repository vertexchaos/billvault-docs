  "paths": {
    "/api/documents/merge": {
      "post": {
        "description": "Phase 12.5: one batched query instead of one per requested document\nid. merge_documents() relies on `documents`' order matching\npayload.document_ids exactly (order's (doc_idx, page_number) pairs\nindex positionally into it) -- rebuild that order explicitly since\n.in_() does not guarantee result order.",
        "operationId": "merge_documents_route_api_documents_merge_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MergeDocumentsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Merge Documents Route"
      }
    },
